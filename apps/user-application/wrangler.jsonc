/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*", "/trpc/*", "/click-socket"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "stage": {
      "vars": {
        "STRIPE_PRODUCT_BASIC": "price_1SH2G4Lxc2ktzrj8WNts7oVh",
        "STRIPE_PRODUCT_PRO": "price_1SH2HYLxc2ktzrj8RnubUThJ",
        "STRIPE_PRODUCT_ENTERPRISE": "price_1SH2I7Lxc2ktzrj8on8E6E07"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "user-application-stage",
          "database_id": "5fcfdc8c-ecd4-48ed-880b-f740b2618e6f",
          "remote": true
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-stage",
          "remote": true
        }
      ]
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "user-application-production",
          "database_id": "380a3594-c22f-49ae-94ac-3eb2fa93c402"
        }
      ],
      "services": [
        {
          "binding": "BACKEND_SERVICE",
          "service": "data-service-production"
        }
      ]
    }
  }
}
